{
  "name": "postroom",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n web,worker \"next dev -p 3010\" \"tsx scripts/worker.ts\"",
    "worker": "tsx scripts/worker.ts",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint",
    "test": "node --import tsx --test --test-concurrency=1 src/lib/csv.test.ts src/lib/render.test.ts src/lib/queue.test.ts src/lib/sql.test.ts src/lib/automations.test.ts src/lib/send-window.test.ts src/lib/automation-rules.test.ts src/lib/bounces.test.ts src/lib/deliverability.test.ts src/lib/dns-check.test.ts src/lib/chart.test.ts src/lib/reports.test.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9",
    "bcryptjs": "^2.4.3",
    "next": "16.2.12",
    "nodemailer": "^7.0.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}

# Postgres connection string. Required in production (for example on Vercel).
# Leave unset locally to use the SQLite file in data/postroom.db instead.
# Neon (Vercel Marketplace): postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Supabase (transaction pooler): postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional TLS override for Postgres: disable, require, prefer, allow or verify-full.
# Default: the sslmode in DATABASE_URL if present, otherwise off for localhost and required elsewhere.
DATABASE_SSL=

# Public URL used in tracking and unsubscribe links.
# Leave unset in local dev and Postroom will use the request host.
APP_ORIGIN=http://localhost:3010

# Encrypts SMTP passwords and signs click links. Use a long random string.
APP_SECRET=

# Pause between messages in the send worker, in milliseconds.
SEND_DELAY_MS=250

# Shared secret for the Vercel Cron worker route (`/api/cron/worker`).
# Vercel sends it as `Authorization: Bearer ${CRON_SECRET}` when the cron fires.
# Generate a long random string and set it for Production and Preview on Vercel.
CRON_SECRET=

# Optional soft wall-clock budget (ms) for one cron invocation when Vercel does
# not expose an invocation deadline. Default 15000.
# CRON_TIME_BUDGET_MS=15000
